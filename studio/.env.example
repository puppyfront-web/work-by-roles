# 复制为 studio/.env。docker compose 会把数据库和 Redis 指到容器网络。
DATABASE_URL=postgresql+psycopg://studio:studio@127.0.0.1:5432/studio
REDIS_URL=redis://127.0.0.1:6379/0

# 签发登录 JWT。换掉它会使已发出的登录失效。
STUDIO_SECRET_KEY=dev-only-change-me

# Fernet 密钥，32 字节 urlsafe base64。留空则从 STUDIO_SECRET_KEY 派生。
# 生成：python -c "import os,base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# 换掉它之后，已经保存的供应商 API Key 无法解密。
STUDIO_FERNET_KEY=

# 1 = API 进程里直接跑会审（无 Redis）。生产用 0，由 worker 消费队列。
STUDIO_RUN_INLINE=0

STUDIO_JWT_TTL_MINUTES=10080
# 刷新令牌有效期（天）。退出登录会使访问令牌和刷新令牌一起失效。
STUDIO_REFRESH_TTL_DAYS=30
STUDIO_CORS_ORIGINS=http://localhost:5173

# running 超过这个秒数会被 worker 标成失败。默认 900。
STUDIO_RUN_TIMEOUT_SECONDS=900

# 邀请链接和邮箱验证令牌的有效期（小时）。
STUDIO_INVITE_TTL_HOURS=72
STUDIO_EMAIL_TOKEN_TTL_HOURS=24

# 认证接口滑动窗口。memory 是单进程；多副本用 redis。
STUDIO_AUTH_RATE_LIMIT=20
STUDIO_AUTH_RATE_WINDOW_SECONDS=60
STUDIO_RATE_LIMIT_BACKEND=memory

# 1 = 未验证邮箱不能创建运行、改契约、管成员和密钥。
STUDIO_REQUIRE_EMAIL_VERIFICATION=0
